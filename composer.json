{
    "name": "matcha/matcha",
    "description": "Matcha — site de rencontre (projet 42) en Slim 4 / PHP",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "slim/twig-view": "^3.4",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
