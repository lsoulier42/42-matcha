<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ app_url }}/assets/css/style.css">
    {% block styles %}{% endblock %}
</head>
<body>
{% include 'partials/navbar.html.twig' %}

<main class="container">
    {% if flash is defined %}
        {% for type, messages in flash %}
            {% for message in messages %}
                <div class="alert alert-{{ type }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}
    {% endif %}
    {% block content %}{% endblock %}
</main>

<footer class="site-footer">
    <div class="container">
        <p>{{ app_name }} — projet École 42</p>
    </div>
</footer>

{% if current_user %}
<script src="{{ app_url }}/assets/js/app.js"></script>
{% endif %}
</body>
</html>
