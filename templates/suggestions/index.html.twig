{% extends 'base.html.twig' %}

{% block title %}Suggestions — {{ app_name }}{% endblock %}

{% block content %}
<h1>Profils suggérés</h1>

{% include 'partials/filters.html.twig' with { action: '/suggestions', sort: sort, filters: filters, all_tags: all_tags } %}

{% if profiles|length > 0 %}
    <div class="user-grid">
        {% for profile in profiles %}
            {% include 'partials/profile_card.html.twig' with { user: profile } %}
        {% endfor %}
    </div>
{% else %}
    {% include 'partials/empty_state.html.twig' with {
        icon: 'search',
        title: 'Aucune suggestion pour le moment',
        text: 'Complétez votre profil (genre, orientation, localisation, tags) pour de meilleures suggestions.',
        cta: { label: 'Compléter mon profil', href: '/profile' }
    } %}
{% endif %}
{% endblock %}
