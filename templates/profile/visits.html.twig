{% extends 'base.html.twig' %}

{% block title %}Qui a consulté mon profil — {{ app_name }}{% endblock %}

{% block content %}
<h1>Qui a consulté mon profil</h1>

{% if visitors|length > 0 %}
    <div class="user-grid">
        {% for visitor in visitors %}
            {% include 'partials/profile_card.html.twig' with { user: visitor, date_label: visitor.date|date('d/m/Y H:i') } %}
        {% endfor %}
    </div>
{% else %}
    {% include 'partials/empty_state.html.twig' with {
        icon: 'eye',
        title: 'Personne n\'a encore consulté votre profil',
        text: 'Complétez votre profil et soyez actif(ve) pour attirer les visites.'
    } %}
{% endif %}
{% endblock %}
