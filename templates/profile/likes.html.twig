{% extends 'base.html.twig' %}

{% block title %}Qui m'a liké — {{ app_name }}{% endblock %}

{% block content %}
<h1>Qui m'a liké</h1>

{% if likers|length > 0 %}
    <div class="user-grid">
        {% for liker in likers %}
            {% include 'partials/profile_card.html.twig' with { user: liker, date_label: liker.date|date('d/m/Y H:i') } %}
        {% endfor %}
    </div>
{% else %}
    {% include 'partials/empty_state.html.twig' with {
        icon: 'heart',
        title: 'Personne ne vous a encore liké',
        text: 'Liker des profils et compléter votre profil augmente vos chances d\'être remarqué(e).'
    } %}
{% endif %}
{% endblock %}
