{% extends 'base.html.twig' %}

{% block title %}{{ user.prenom }} — {{ app_name }}{% endblock %}

{% block content %}
<div class="user-show">
    {% set main = photos|filter(p => p.isProfile)|first %}

    {# ============ Hero photo plein format ============ #}
    <section class="user-hero">
        <div class="user-hero-photo">
            {% if main %}
                <img src="{{ app_url }}{{ main.path }}" alt="Photo de {{ user.prenom }}" class="hero-photo">
            {% else %}
                <div class="avatar-placeholder big">{{ user.prenom|first|upper }}</div>
            {% endif %}

            {# Teaser de popularité — discret, en haut à droite #}
            <span class="popularity-teaser" title="Popularité {{ user.popularityDisplay }}/10">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4"/>
                    <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/>
                </svg>
                {{ user.popularityDisplay }}
            </span>

            {# Statut (sauge « En ligne » / hors ligne) #}
            <span class="online-chip">
                {% if user.isOnline %}
                    <span class="online-dot"></span> En ligne
                {% else %}
                    <span class="offline-dot"></span> Vu {{ user.lastSeen }}
                {% endif %}
            </span>

            {# Tampons de swipe (enhancement JS, invisibles par défaut) #}
            <span class="swipe-stamp stamp-like" aria-hidden="true">LIKE</span>
            <span class="swipe-stamp stamp-nope" aria-hidden="true">NOPE</span>

            <div class="user-hero-scrim" aria-hidden="true"></div>

            <div class="user-hero-head">
                <h1 class="user-hero-name">{{ user.prenom }}{% if user.age is not null %}, {{ user.age }}{% endif %}</h1>
                <p class="user-hero-meta">
                    {% if user.ville %}<span>📍 {{ user.ville }}</span>{% endif %}
                    {% if not user.ville %}<span>Localisation inconnue</span>{% endif %}
                </p>
            </div>
        </div>
    </section>

    {# ============ Informations ============ #}
    <section class="user-info-card">
        {% if user.bio %}
            <h2>Biographie</h2>
            <p class="user-bio">{{ user.bio }}</p>
        {% endif %}

        <h2>À propos</h2>
        <ul class="user-facts">
            <li>
                <span aria-hidden="true">🎭</span>
                Genre : {{ gender_labels[user.genre] ?? 'Non renseigné' }}
            </li>
            <li>
                <span aria-hidden="true">💞</span>
                Orientation : {{ orientation_labels[user.orientation] ?? 'Bisexuel·le par défaut' }}
            </li>
        </ul>

        {% if tags|length > 0 %}
            <h2>Centres d'intérêt</h2>
            <div class="tag-list">
                {% for tag in tags %}
                    <span class="tag-chip">#{{ tag.name }}</span>
                {% endfor %}
            </div>
        {% endif %}

        {% if photos|length > 1 %}
            <h2>Galerie</h2>
            <div class="photo-grid">
                {% for photo in photos|filter(p => not p.isProfile) %}
                    <div class="photo-item">
                        <img src="{{ app_url }}{{ photo.path }}" alt="Photo {{ loop.index }}" loading="lazy">
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    {# ============ Actions : like / match / blocage ============ #}
    <section class="user-actions-card">
        {% if is_match %}
            <div class="alert alert-success">❤️ Vous êtes connectés ! Le chat est débloqué.</div>
        {% elseif liked_me %}
            <div class="alert alert-info">Cette personne vous a liké.</div>
        {% elseif i_liked %}
            <div class="alert alert-info">Vous avez liké ce profil.</div>
        {% endif %}

        <div class="user-actions-row">
            {% if is_match %}
                <a class="btn btn-primary btn-lg" href="/messages/{{ user.id }}">💬 Discuter</a>
            {% elseif not i_liked %}
                <form method="post" action="/user/{{ user.id }}/like" class="swipe-form" data-swipe="like">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button class="action-btn action-like" type="submit" aria-label="Liker {{ user.prenom }}" title="Liker {{ user.prenom }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>
                        </svg>
                    </button>
                    <span class="action-label">Liker</span>
                </form>
            {% endif %}

            {% if i_liked %}
                <form method="post" action="/user/{{ user.id }}/unlike" class="swipe-form" data-swipe="nope">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button class="action-btn action-nope" type="submit" aria-label="Retirer le like" title="Retirer le like">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0l-1 1-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>
                            <path d="m9.5 10 5 5"/>
                        </svg>
                    </button>
                    <span class="action-label">Retirer</span>
                </form>
            {% endif %}
        </div>

        <div class="user-actions-ghost">
            <form method="post" action="/user/{{ user.id }}/block" class="inline"
                  onsubmit="return confirm('Bloquer {{ user.prenom }} ? Il disparaîtra de vos recherches.');">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button class="btn btn-ghost btn-sm" type="submit">🚫 Bloquer</button>
            </form>
        </div>

        <form method="post" action="/user/{{ user.id }}/report" class="report-form">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <div class="form-field">
                <label for="reason">Signaler ce profil (faux compte…)</label>
                <div class="report-row">
                    <select id="reason" name="reason" required>
                        <option value="Faux compte">Faux compte</option>
                        <option value="Spam">Spam</option>
                        <option value="Propos inappropriés">Propos inappropriés</option>
                        <option value="Autre">Autre</option>
                    </select>
                    <button class="btn btn-danger" type="submit">Envoyer</button>
                </div>
            </div>
        </form>
    </section>

    {# ============ Écran « C'est un match ! » (enhancement JS) ============ #}
    <div class="match-overlay" id="match-overlay">
        <div class="match-card">
            <div class="match-avatars">
                <div class="match-avatar match-avatar-mine">
                    {% if my_avatar %}
                        <img src="{{ app_url }}{{ my_avatar }}" alt="Vous">
                    {% else %}
                        <div class="avatar-placeholder">{{ current_user.prenom|first|upper }}</div>
                    {% endif %}
                </div>
                <div class="match-avatar match-avatar-theirs">
                    {% if main %}
                        <img src="{{ app_url }}{{ main.path }}" alt="{{ user.prenom }}">
                    {% else %}
                        <div class="avatar-placeholder">{{ user.prenom|first|upper }}</div>
                    {% endif %}
                </div>
                <span class="match-heart" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>
                    </svg>
                </span>
            </div>
            <h2 class="match-title">C'est un match !</h2>
            <p class="match-subtitle">Vous et {{ user.prenom }} vous êtes likés.</p>
            <div class="match-actions">
                <a class="btn btn-primary" href="/messages/{{ user.id }}" id="match-chat">💬 Discuter</a>
                <button class="btn btn-outline" type="button" id="match-close">Continuer</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}
