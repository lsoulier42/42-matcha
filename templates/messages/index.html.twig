{% extends 'base.html.twig' %}

{% block title %}Messages — {{ app_name }}{% endblock %}

{% block content %}
<h1>Messages</h1>

{% if conversations|length > 0 %}
    <div class="conversation-list">
        {% for conv in conversations %}
            <a class="conversation-item{{ current_path == '/messages/' ~ conv.id ? ' active' : '' }}" href="/messages/{{ conv.id }}">
                <div class="conversation-avatar">
                    {% if conv.avatar %}
                        <img src="{{ app_url }}{{ conv.avatar }}" alt="{{ conv.prenom }}">
                    {% else %}
                        <div class="avatar-placeholder small">{{ conv.prenom|first|upper }}</div>
                    {% endif %}
                    {% if conv.unread > 0 %}<span class="badge">{{ conv.unread }}</span>{% endif %}
                </div>
                <div class="conversation-body">
                    <div class="conversation-top">
                        <strong>{{ conv.prenom }}</strong>
                        <time>{{ conv.lastMessageAtLabel }}</time>
                    </div>
                    <div class="conversation-preview {{ conv.unread > 0 ? 'unread' : '' }}">
                        {{ conv.lastMessage ? conv.lastMessage : 'Dites bonjour 👋' }}
                    </div>
                </div>
            </a>
        {% endfor %}
    </div>
{% else %}
    {% include 'partials/empty_state.html.twig' with {
        icon: 'chat',
        title: 'Aucune conversation',
        text: 'Liker des profils pour déclencher un match : le chat s\'ouvre dès que vous êtes « connectés » avec quelqu\'un.',
        cta: { label: 'Voir les suggestions', href: '/suggestions' }
    } %}
{% endif %}
{% endblock %}
