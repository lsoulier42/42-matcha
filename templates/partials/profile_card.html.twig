{# ============================================================
   Carte profil GRAND FORMAT (DESIGN.md §5.7)
   Usage : {% include 'partials/profile_card.html.twig' with { user: profile, date_label: …, online: bool, tags: […] } %}
   - user       : ViewModel App\ViewModel\ProfileCard
                  (prenom, age, ville, distanceKm, popularityDisplay, sharedTags, bio, avatar, date)
   - date_label : texte optionnel affiché en pied de carte (visites / likes)
   - online     : bool optionnel — pastille « En ligne » (sauge)
   - tags       : liste optionnelle de noms de tags affichés en chips (2-3 max)
   ============================================================ #}
<article class="profile-card">
    <a class="profile-card-link" href="/user/{{ user.id }}">
        <div class="profile-card-photo">
            {% if user.avatar %}
                <img src="{{ app_url }}{{ user.avatar }}" alt="Photo de {{ user.prenom }}" loading="lazy">
            {% else %}
                <div class="avatar-placeholder">{{ user.prenom|first|upper }}</div>
            {% endif %}

            {# Teaser de popularité — discret, en haut à droite #}
            <span class="popularity-teaser" title="Popularité {{ user.popularityDisplay }}/10">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4"/>
                    <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/>
                </svg>
                {{ user.popularityDisplay }}
            </span>

            {% if online is defined and online %}
                <span class="online-chip"><span class="online-dot"></span> En ligne</span>
            {% endif %}

            <div class="profile-card-scrim" aria-hidden="true"></div>

            <div class="profile-card-head">
                <h3 class="profile-card-name">{{ user.prenom }}{% if user.age is not null %}, {{ user.age }}{% endif %}</h3>
                <p class="profile-card-meta">
                    {% if user.ville %}<span>📍 {{ user.ville }}</span>{% endif %}
                    {% if user.distanceKm is not null %}<span>· à {{ user.distanceKm|replace({'.': ','}) }} km</span>{% endif %}
                    {% if not user.ville and user.distanceKm is null %}<span>Localisation inconnue</span>{% endif %}
                </p>
            </div>
        </div>

        {% set has_chips = user.sharedTags > 0 or (tags is defined and tags|length > 0) %}
        {% if has_chips or user.bio %}
            <div class="profile-card-body">
                {% if has_chips %}
                    <div class="profile-card-tags">
                        {% if user.sharedTags > 0 %}
                            <span class="tag-chip"># {{ user.sharedTags }} tag(s) en commun</span>
                        {% endif %}
                        {% if tags is defined %}
                            {% for tag in tags|slice(0, 3) %}
                                <span class="tag-chip">#{{ tag }}</span>
                            {% endfor %}
                        {% endif %}
                    </div>
                {% endif %}

                {% if user.bio %}
                    <p class="profile-card-bio">{{ user.bio }}</p>
                {% endif %}
            </div>
        {% endif %}
    </a>

    {% if date_label is defined and date_label %}
        <time class="profile-card-date">{{ date_label }}</time>
    {% endif %}
</article>
