{# ============================================================
   État vide illustré (DESIGN.md §5.10)
   Usage : {% include 'partials/empty_state.html.twig' with {
              icon: 'heart'|'chat'|'search'|'map'|'calendar'|'sun'|'bell'|'eye',
              title: '…', text: '…',
              cta: { label: '…', href: '/…' },
              compact: true  (optionnel : sans bordure/carte, pour les sections de page)
            } %}
   Icônes inline SVG (aucun asset externe), palette terracotta/sauge.
   ============================================================ #}
<div class="empty-state{{ compact is defined and compact ? ' compact' : '' }}">
    <div class="empty-state-icon" aria-hidden="true">
        {% if icon == 'heart' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>
            </svg>
        {% elseif icon == 'chat' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
        {% elseif icon == 'search' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                 stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7"/>
                <path d="m21 21-4.3-4.3"/>
            </svg>
        {% elseif icon == 'map' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21s-7-5.1-7-11a7 7 0 0 1 14 0c0 5.9-7 11-7 11z"/>
                <circle cx="12" cy="10" r="2.6"/>
            </svg>
        {% elseif icon == 'calendar' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                 stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="16" rx="2"/>
                <path d="M3 9h18M8 3v4M16 3v4"/>
            </svg>
        {% elseif icon == 'sun' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                 stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/>
            </svg>
        {% elseif icon == 'bell' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 9a6 6 0 1 0-12 0c0 5-2 6-2 6h16s-2-1-2-6"/>
                <path d="M10 19a2.2 2.2 0 0 0 4 0"/>
            </svg>
        {% elseif icon == 'eye' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/>
                <circle cx="12" cy="12" r="3"/>
            </svg>
        {% endif %}
    </div>

    <h2 class="empty-state-title">{{ title }}</h2>
    {% if text %}<p class="empty-state-text">{{ text }}</p>{% endif %}
    {% if cta is defined and cta %}
        <a class="btn btn-primary" href="{{ cta.href }}">{{ cta.label }}</a>
    {% endif %}
</div>
