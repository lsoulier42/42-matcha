<a class="user-card" href="/user/{{ user.id }}">
    <div class="user-avatar">
        {% if user.avatar %}
            <img src="{{ app_url }}{{ user.avatar }}" alt="{{ user.prenom }}" loading="lazy">
        {% else %}
            <div class="avatar-placeholder">{{ user.prenom|first|upper }}</div>
        {% endif %}
    </div>
    <div class="user-info">
        <strong>{{ user.prenom }} ({{ user.age ?? '?' }})</strong>
        <span class="user-meta">
            {{ user.ville ?? 'Localisation inconnue' }}
            {% if user.distance_km is not null %} — à {{ user.distance_km|replace({'.': ','}) }} km{% endif %}
        </span>
        <span class="user-meta">⭐ Popularité {{ user.popularity_display }}/10</span>
        {% if user.shared_tags > 0 %}
            <span class="user-meta tags-common"># {{ user.shared_tags }} tag(s) en commun</span>
        {% endif %}
        {% if user.bio %}
            <span class="user-bio">{{ user.bio|slice(0, 90) }}{% if user.bio|length > 90 %}…{% endif %}</span>
        {% endif %}
    </div>
</a>
