{# Panneau tri + filtres (suggestions et recherche) #}
<form method="get" action="{{ action }}" class="filter-panel" autocomplete="off">
    <div class="filter-row">
        <div class="form-field">
            <label for="sort">Trier par</label>
            <select id="sort" name="sort">
                <option value="score" {{ sort == 'score' ? 'selected' : '' }}>Recommandés</option>
                <option value="age" {{ sort == 'age' ? 'selected' : '' }}>Âge</option>
                <option value="location" {{ sort == 'location' ? 'selected' : '' }}>Localisation (proximité)</option>
                <option value="popularity" {{ sort == 'popularity' ? 'selected' : '' }}>Popularité</option>
                <option value="tags" {{ sort == 'tags' ? 'selected' : '' }}>Tags communs</option>
            </select>
        </div>
        <div class="form-field">
            <label for="age_min">Âge min</label>
            <input type="number" id="age_min" name="age_min" min="16" max="100" value="{{ filters.age_min }}" placeholder="18">
        </div>
        <div class="form-field">
            <label for="age_max">Âge max</label>
            <input type="number" id="age_max" name="age_max" min="16" max="100" value="{{ filters.age_max }}" placeholder="45">
        </div>
        <div class="form-field">
            <label for="popularity_min">Popularité min (0–10)</label>
            <input type="number" id="popularity_min" name="popularity_min" min="0" max="10" step="0.5" value="{{ filters.popularity_min }}" placeholder="3">
        </div>
        <div class="form-field">
            <label for="ville">Ville / quartier</label>
            <input type="text" id="ville" name="ville" value="{{ filters.ville }}" maxlength="120" placeholder="Ex. Lyon">
        </div>
        <div class="form-field">
            <label for="tags">Tags (au moins un)</label>
            <select id="tags" name="tags[]" multiple size="4">
                {% for tag in all_tags %}
                    <option value="{{ tag.name }}" {{ tag.name in filters.tags ? 'selected' : '' }}>#{{ tag.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="filter-actions">
            <button class="btn btn-primary" type="submit">Filtrer</button>
            <a class="btn btn-ghost" href="{{ action }}">Réinitialiser</a>
        </div>
    </div>
</form>
