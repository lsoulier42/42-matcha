# Matcha — variables d'environnement (copier vers .env, NE JAMAIS committer .env)
APP_ENV=dev
APP_URL=http://localhost:8090

# Base de données (conteneur MySQL docker-compose)
DB_HOST=db
DB_PORT=3306
DB_NAME=matcha
DB_USER=matcha
DB_PASS=matcha_dev_pw
DB_ROOT_PASS=root_dev_pw

# Mail — SMTP MailHog en dev (pas d'authentification)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@matcha.local
MAIL_FROM_NAME=Matcha
